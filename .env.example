# ---- Fixtures (football-data.org) ----
# Free key: https://www.football-data.org/client/register
# Free tier covers PL, PD, SA, BL1, FL1, CL (+ Eredivisie, Primeira Liga, Championship, Brasileirao).
# Europa League, Conference League, EFL Cup and Copa Libertadores need a paid plan (Standard, EUR49/mo).
FOOTBALL_DATA_API_KEY=

# Set to "true" once you're on a paid football-data.org plan to unlock the
# four gated competitions (EL, ECL, EFL Cup, Copa Libertadores).
FOOTBALL_DATA_PAID_TIER=false

# ---- Scraper behaviour ----
# Currency the ticket sites should be asked to quote in.
SCORETICKET_CURRENCY=EUR

# Politeness: milliseconds between requests to the SAME source.
SCRAPER_DELAY_MS=2500

# How long a source stays "blocked" (skipped) after repeated failures, in minutes.
SCRAPER_COOLDOWN_MINUTES=45

# Comma-separated source ids to disable entirely.
# stubhub is off by default: its /explore endpoint only returns events near the
# requesting server's IP and ignores search params, so it can't cover these
# competitions without StubHub's partner API. Remove it here once you have one.
SCRAPER_DISABLED_SOURCES=stubhub

# ---- Book a demo ----
# Scheduling link behind the "Let's talk" button on /demo.
# Defaults to https://calendly.com/jonaskyzas/30min — only set this if the
# booking link moves.
NEXT_PUBLIC_DEMO_BOOKING_URL=

# ---- Refresh job ----
# Shared secret for POST /api/cron/refresh so the endpoint isn't publicly triggerable.
CRON_SECRET=
